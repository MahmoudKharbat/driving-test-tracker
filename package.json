{
  "name": "driving-test-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^26.1.0",
    "@react-native-firebase/auth": "^26.1.0",
    "@react-native-firebase/firestore": "^26.1.0",
    "expo": "~57.0.10",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --clear",
    "start:dev-client": "expo start --dev-client",
    "start:firebase": "EXPO_PUBLIC_BACKEND=firebase expo start --dev-client --clear",
    "android": "expo run:android",
    "android:firebase": "EXPO_PUBLIC_BACKEND=firebase expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test:names": "node --no-warnings --experimental-strip-types scripts/test-hebrew-name.mts",
    "seed:cities": "node firebase/functions/scripts/seed-cities.mjs",
    "functions:build": "npm --prefix firebase/functions run build",
    "deploy:rules": "cd firebase && firebase deploy --only firestore:rules",
    "deploy:functions": "cd firebase && firebase deploy --only functions",
    "build:dev": "eas build --profile development --platform android",
    "build:prod": "eas build --profile production --platform android"
  },
  "private": true
}
