# expo-router's web-only deps (vaul -> @radix-ui) pull react-dom@19.2.8, which peers
# on react@^19.2.8, while Expo SDK 57 pins react@19.2.3. The conflict ships with the
# Expo template itself and only affects the web target, which this app does not use
# (Android first, iOS later). Without this, every `npx expo install` fails on ERESOLVE.
legacy-peer-deps=true
